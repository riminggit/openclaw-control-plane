APP_NAME=OpenClaw Control Plane API
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_URL=sqlite:///./control_plane.db
CORS_ORIGINS=*
# 生产环境必须设置强随机密钥；与 docker/k8s 中 JWT_SECRET_KEY 一致
JWT_SECRET_KEY=

# --- OpenClaw v3（默认 false，按需开启）---
# ORCHESTRATION_V3_ENABLED=true
# COORDINATOR_MODE_ENABLED=true
# 兼容旧部署：与 COORDINATOR_MODE_ENABLED 二选一即可
# OPENCLAW_FEATURE_COORDINATOR_MODE=true
